# Salin fail ini kepada ".env" dan isi nilai anda.  (cp .env.example .env)

# --- Login website (WAJIB diisi jika website boleh dibuka orang lain) ---
WEB_USER=admin
WEB_PASSWORD=tukar-kata-laluan-ini

# --- Pilihan A: Token peribadi (PAT) - paling cepat, TAPI hanya sah 24 jam ---
# Jana di https://account.smartthings.com/tokens  (tanda: Devices -> list, see, control)
SMARTTHINGS_TOKEN=

# --- Pilihan B: OAuth - untuk guna jangka panjang (token diperbaharui automatik) ---
# Dapatkan dengan "smartthings apps:create" (lihat README.md)
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=https://httpbin.org/get

# --- Pilihan lain ---
# Kosongkan untuk pilih aircond dari website
SMARTTHINGS_DEVICE_ID=
PORT=8080
